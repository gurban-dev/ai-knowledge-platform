{
  "name": "@akp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsx watch src/main.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@akp/ai": "workspace:*",
    "@akp/config": "workspace:*",
    "@akp/core": "workspace:*",
    "@akp/db": "workspace:*",
    "@akp/observability": "workspace:*",
    "@akp/storage": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^8.1.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.12.0",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@akp/eslint-config": "workspace:*",
    "@akp/tsconfig": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.14.10",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.10.0",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
